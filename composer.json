{
  "name": "naf/mail",
  "description": "NAF Mail Plugin for quick email communication.",
  "minimum-stability": "stable",
  "license": "MIT",
  "type": "naf-plugin",
  "authors": [
    {
      "name": "Flo Knapp",
      "email": "office@florianknapp.de"
    }
  ],
  "autoload": {
    "psr-4": {
      "Naf\\Mail\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/",
      "Fixtures\\": "tests/Fixtures/"
    }
  },
  "require": {
    "php": ">=8.3",
    "ext-fileinfo": "*",
    "ext-openssl": "*",
    "ext-mbstring": "*",
    "naf/framework": "^0.2",
    "symfony/mailer": "^7.4"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "3.95.25",
    "phpunit/php-code-coverage": "^12.1",
    "phpunit/phpunit": "^12.1"
  },
  "scripts": {
    "test": "phpunit --colors=always",
    "style:check": "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
    "style:fix": "@php vendor/bin/php-cs-fixer fix",
    "test:smtp": [
      "docker compose -f tests/Smtp/compose.yaml up -d --build --wait",
      "phpunit -c phpunit.smtp.xml"
    ]
  },
  "config": {
    "platform": {
      "php": "8.3.0"
    }
  }
}
